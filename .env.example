# ==============================================================================
# Public School Niyazipur - Environment Variables Template
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Allowed CORS Origins (comma-separated whitelist)
ALLOWED_ORIGINS=https://simplyshreyash.github.io,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Defaults to embedded high-performance SQLite)
DB_PATH=./data/submissions.sqlite

# Admin Dashboard Authentication Credentials
ADMIN_EMAIL=admin@publicschoolniyazipur.in
ADMIN_PASSWORD=Admin@2026_ChangeThisPassword!
JWT_SECRET=super_secure_random_jwt_secret_key_at_least_32_characters_long_2026

# Automated Email Notification Service (SMTP)
# Options:
# 1. Gmail SMTP: host=smtp.gmail.com, port=465, user=your_email@gmail.com, pass=Google_App_Password
# 2. SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.your_api_key
# 3. Resend: host=smtp.resend.com, port=465, user=resend, pass=re_your_api_key
# 4. Amazon SES: host=email-smtp.us-east-1.amazonaws.com, port=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email Alert Recipients
ADMIN_NOTIFICATION_EMAIL=shreyash10nov@gmail.com
ALERT_TO_EMAIL=shreyash10nov@gmail.com
ALERT_FROM_EMAIL="Public School Leads" <no-reply@publicschoolniyazipur.in>
ADMIN_PORTAL_URL=http://localhost:3000/admin
